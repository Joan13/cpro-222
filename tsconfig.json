{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "yambi-call": ["./modules/yambi-call"],
      "proximity": ["./modules/proximity"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
